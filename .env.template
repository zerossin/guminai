# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0

# Asset Versioning (auto-generated at deploy time; empty means use timestamp)
ASSET_VERSION=

# Clova API Credentials (from Naver Cloud)
CLOVA_API_KEY=your_clova_api_key_here
CLOVA_PRIMARY_KEY=your_clova_primary_key_here
CLOVA_REQUEST_ID=your_clova_request_id_here

# Flask Secret Key (use a secure random string)
SECRET_KEY=your_secret_key_here_change_in_production

# Logging Level
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
POSTGRES_DB=guminai_db
POSTGRES_USER=guminai_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://guminai_user:your_secure_postgres_password_here@database:5432/guminai_db
